# Copy to .env and fill in.

# --- pipeline ---------------------------------------------------------------
OPENAI_API_KEY=sk-...

# --- database ---------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://postgres:overhand@localhost:5432/postgres

# --- auth -------------------------------------------------------------------
# OAuth 2.0 Web client id from https://console.cloud.google.com/apis/credentials
# with http://localhost:8000 as an authorized JavaScript origin.
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# Signs the session cookie. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=change-me

# --- app --------------------------------------------------------------------
# dev drops the Secure flag on the session cookie so plain http://localhost works.
APP_ENV=dev
# Pages a user may read before uploads are refused with 402.
FREE_PAGE_LIMIT=100
# Comma-separated. Only needed if the frontend is served from another origin.
ALLOWED_ORIGINS=http://localhost:8000
